# MODELO — este arquivo VAI para o Git. Não escreva senha de verdade aqui.
#
# Copie para ".env" nesta pasta (copy .env.example .env) e preencha lá.
# O ".env" é ignorado pelo .gitignore da raiz. Lido pelo config.py.
#
# São as MESMAS credenciais do banco que o backend Java usa em DB_USER /
# DB_PASSWORD — a diferença é que aqui o host e o banco vão separados, não
# dentro de uma URL jdbc.
#
# No deploy (Render) NÃO existe arquivo .env: cada linha abaixo vira uma
# variável de ambiente em Environment > Environment Variables.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ctiinsights
DB_USER=
DB_PASSWORD=
# Neon e Azure exigem conexão criptografada: require. Local: prefer.
DB_SSLMODE=require

# Chave combinada com o ETL_KEY do backend (header X-ETL-Key).
# Vazia nos dois lados = sem autenticação (basta para rodar na sua máquina).
# No deploy preencha nos DOIS serviços com o mesmo valor: sem isso qualquer
# pessoa que descobrir a URL do Python consegue gravar no banco.
ETL_API_KEY=
