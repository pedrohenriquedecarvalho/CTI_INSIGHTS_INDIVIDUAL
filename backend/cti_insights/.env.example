# Copie para ".env" nesta pasta (backend/cti_insights/.env). O .env NUNCA vai para o Git.

# ---- Banco PostgreSQL ----
# Azure: jdbc:postgresql://SEU-SERVIDOR.postgres.database.azure.com:5432/SEU_BANCO?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/ctiinsights
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# ---- Segurança ----
# Segredo que assina o token JWT (mínimo 32 caracteres). Invente o seu.
JWT_SECRET=invente-um-segredo-com-pelo-menos-32-caracteres
CORS_ORIGINS=http://localhost:5173

# ---- Administrador (criado sozinho na primeira vez) ----
ADMIN_EMAIL=admin@cti.local
ADMIN_PASSWORD=Admin@12345

# ---- Python (ETL) ----
ETL_URL=http://localhost:8000/etl
# Chave combinada com o Python (ETL_API_KEY em analytics-python/.env). Vazio = sem chave.
ETL_KEY=
