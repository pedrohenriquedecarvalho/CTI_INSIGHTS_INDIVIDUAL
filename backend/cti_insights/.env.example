# MODELO — este arquivo VAI para o Git. Não escreva senha de verdade aqui.
#
# Copie para ".env" nesta pasta (copy .env.example .env) e preencha lá.
# O ".env" é ignorado pelo .gitignore da raiz.
# Lido pelo application.properties (spring.config.import=optional:file:.env).
#
# No deploy (Render) NÃO existe arquivo .env: cada linha abaixo vira uma
# variável de ambiente em Environment > Environment Variables.

# ---- Banco PostgreSQL (Neon ou Azure) ----
# Neon: pegue a connection string e tire usuário, senha e channel_binding.
#   postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require&channel_binding=require
#   fica: jdbc:postgresql://HOST/BANCO?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/ctiinsights
DB_USER=
DB_PASSWORD=

# ---- JWT: segredo que assina o token do login ----
# Mínimo 32 caracteres. Gere um no PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# ---- CORS: quem pode chamar a API. Lista separada por vírgula ----
# Local: http://localhost:5173
# Deploy: a URL da Vercel, SEM barra no final (ex.: https://cti-insights.vercel.app)
CORS_ORIGINS=http://localhost:5173

# ---- Administrador criado na primeira vez que o sistema liga ----
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@cti.local
ADMIN_PASSWORD=Admin@12345

# ---- Upload ----
UPLOAD_MAX_LINHAS=5000

# ---- Ligação com o serviço Python (ETL) ----
# Local: http://localhost:8000/etl
# Deploy: https://SEU-PYTHON.onrender.com/etl  (precisa terminar em /etl)
ETL_URL=http://localhost:8000/etl
# Chave combinada com o ETL_API_KEY do analytics-python/.env.
# Vazia nos dois lados = sem autenticação (basta para rodar na sua máquina).
ETL_KEY=
